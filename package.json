{
  "name": "swagger-autodoc",
  "version": "1.0.0",
  "description": "Zero-config Swagger/OpenAPI docs for NestJS: reads your TypeScript to document schemas, errors, auth and pagination, and adds Postman-style variables in Swagger UI.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nestjs",
    "swagger",
    "openapi",
    "swagger-ui",
    "api-documentation",
    "documentation-generator",
    "typescript",
    "nodejs",
    "postman",
    "autodoc"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/rewrite-ts.js",
    "test": "jest",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9",
    "@nestjs/core": ">=9",
    "@nestjs/swagger": ">=6",
    "class-validator": ">=0.13",
    "reflect-metadata": ">=0.1.13",
    "rxjs": ">=7",
    "typescript": ">=4.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/testing": "^10.4.22",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^10.4.22",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "typescript-fallback": "npm:typescript@5.9.3"
  },
  "bin": {
    "swagger-autodoc": "dist/cli.js"
  },
  "author": "Mohamed Rashad"
}
